<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Recipe</title>
</head>
<body>
     <%- include('../partials/_navbar.ejs') %>

     <h1>Edit <%= recipe.name %></h1>

    <form action="/recipes/<%= recipe._id %>?_method=PUT" method="POST">

        <div>
            <label for="name">Recipe Name:</label>
            <input type="text" name="name" id="name" value="<%= recipe.name %>">
        </div>

        <div>
            <label for="instructions">Recipe Instructions:</label>
            <input type="text" name="instructions" id="instructions" value="<%= recipe.instructions %>">
        </div>

        <div>
            <label for="ingredients">Recipe Ingredients</label>
            <% ingredients.forEach((ingredient) => { %>
                <label>
                    <input 
                        type="checkbox"
                        name="ingredients"
                        value="<%= ingredient._id %>"
                        <% if (recipe.ingredients.some(id => id.equals(ingredient._id))) { %> checked <% } %>
                        >
                        <%= ingredient.name %>
                </label>
            <% }); %>
        </div>

    <button type="submit">Update Recipe</button>
    </form>

    <a href="/recipes/<%= recipe._id %>">Cancel</a>
</body>
</html>